[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="avatars"
3d_physics/layer_3="stairs_walk_surface"
3d_physics/layer_4="stairs_steps"
3d_navigation/layer_1="floor"
3d_navigation/layer_2="ramp"
3d_navigation/layer_3="stairs"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=false
3d/physics_engine="Jolt Physics"

[rendering]

