; SOMA RANGE scaffold, pinned baseline Godot 4.5.1
config_version=5

[application]
config/name="SOMA RANGE — Offline Harness"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1000
window/size/viewport_height=680

[rendering]
renderer/rendering_method="gl_compatibility"
