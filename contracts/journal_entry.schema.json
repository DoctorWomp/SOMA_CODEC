{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soma-range.invalid/v1/journal_entry.schema.json",
  "title": "Event journal entry",
  "description": "One line of the JSONL event journal (Blueprint §13.3). Evaluator-side: may contain world truth. G0 covers the kinds the headless test world writes; G2 extends it.",
  "x-audience": "evaluator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seq",
    "tick_id",
    "sim_time_ms",
    "kind",
    "actor_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "seq": {
      "description": "Order within the journal, starting at 0.",
      "type": "integer",
      "minimum": 0
    },
    "tick_id": {
      "$ref": "common.schema.json#/$defs/tick"
    },
    "sim_time_ms": {
      "$ref": "common.schema.json#/$defs/time_ms"
    },
    "kind": {
      "enum": [
        "RUN_STARTED",
        "COMMAND_APPLIED",
        "OBSERVATION_DELIVERED",
        "OBSERVATION_DROPPED",
        "GESTURE_PERFORMED",
        "GESTURE_REFUSED",
        "SPEECH_EMITTED",
        "COMMS_EVENT",
        "COMMS_REJECTED",
        "GROUP_CHANGED",
        "ACTION_RESOLVED",
        "LINK_STATUS",
        "SCENARIO_EVENT",
        "EXPRESSION_SHOWN",
        "RUN_ENDED",
        "INTERVENTION"
      ]
    },
    "actor_id": {
      "$ref": "common.schema.json#/$defs/nullable_id"
    },
    "payload": {
      "description": "Closed per kind by the allOf rules below.",
      "type": "object",
      "x-closed-by": "kind"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RUN_STARTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/run_started"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "COMMAND_APPLIED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/command_applied"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "OBSERVATION_DELIVERED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "observation.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "OBSERVATION_DROPPED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/observation_dropped"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "GESTURE_PERFORMED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/gesture_performed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "GESTURE_REFUSED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/gesture_refused"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SPEECH_EMITTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/speech_emitted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "COMMS_EVENT"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "comms_event.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "COMMS_REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/comms_rejected"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "GROUP_CHANGED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/group_changed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ACTION_RESOLVED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/action_resolved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "LINK_STATUS"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/link_status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RUN_ENDED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/run_ended"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SCENARIO_EVENT"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/scenario_event"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "EXPRESSION_SHOWN"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/expression_shown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "INTERVENTION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/intervention_journal"
          }
        }
      }
    }
  ],
  "$defs": {
    "avatar_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avatar_id",
        "x",
        "z",
        "yaw_rad"
      ],
      "properties": {
        "avatar_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "yaw_rad": {
          "type": "number"
        }
      }
    },
    "run_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "map_id",
        "tick_hz",
        "avatars"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "map_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "tick_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "avatars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/avatar_state"
          }
        },
        "sample_hz": {
          "description": "How often observations are sampled, per second. tick_hz is the world tick (60 in Godot, D-33).",
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        }
      }
    },
    "command_applied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "avatar_id",
        "result"
      ],
      "properties": {
        "op": {
          "enum": [
            "SET_POSE",
            "MOVE_BY",
            "TURN_BY"
          ]
        },
        "avatar_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "dx": {
          "type": "number"
        },
        "dz": {
          "type": "number"
        },
        "dyaw_rad": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "yaw_rad": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/avatar_state"
        }
      }
    },
    "observation_dropped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_id",
        "target_id",
        "reason"
      ],
      "properties": {
        "observer_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "target_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "reason": {
          "enum": [
            "SENSOR_DROPOUT"
          ]
        }
      }
    },
    "run_ended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticks_run"
      ],
      "properties": {
        "ticks_run": {
          "type": "integer",
          "minimum": 0
        },
        "avatars": {
          "description": "Where each avatar ended (G3a; evaluator).",
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/final_state"
          }
        },
        "held_ticks": {
          "description": "Stepped runs: samples at which the world waited for the agents (D-48).",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gesture_performed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avatar_id",
        "event_id",
        "gesture",
        "duration_ms"
      ],
      "properties": {
        "avatar_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "event_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "gesture": {
          "$ref": "common.schema.json#/$defs/gesture"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "amplitude": {
          "$ref": "common.schema.json#/$defs/prosody_factor",
          "description": "Present only when the request gave one; the value after the body clamped it."
        },
        "tempo": {
          "$ref": "common.schema.json#/$defs/prosody_factor",
          "description": "Present only when the request gave one; the value after the body clamped it. duration_ms follows from it."
        }
      }
    },
    "gesture_refused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avatar_id",
        "gesture",
        "reason_code"
      ],
      "properties": {
        "avatar_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "gesture": {
          "$ref": "common.schema.json#/$defs/gesture"
        },
        "reason_code": {
          "enum": [
            "CAPABILITY_DENIED"
          ]
        }
      }
    },
    "speech_emitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avatar_id",
        "event_id",
        "channel",
        "text",
        "addressee_id",
        "level_db",
        "duration_ms"
      ],
      "properties": {
        "avatar_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "event_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "channel": {
          "const": "LOCAL"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "addressee_id": {
          "$ref": "common.schema.json#/$defs/nullable_id"
        },
        "level_db": {
          "description": "Speech level at 1 m (synthetic proxy, D-40).",
          "type": "number",
          "minimum": 0,
          "maximum": 140
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "comms_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sender_id",
        "channel",
        "reason_code"
      ],
      "properties": {
        "sender_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "channel": {
          "$ref": "common.schema.json#/$defs/channel"
        },
        "reason_code": {
          "enum": [
            "CAPABILITY_DENIED",
            "GROUP_NOT_MEMBER",
            "PA_UNAUTHORIZED",
            "PRIVACY_SCOPE_DENIED",
            "TARGET_UNKNOWN",
            "RATE_LIMITED",
            "INVALID_SCHEMA"
          ]
        }
      }
    },
    "group_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "op",
        "actor_id",
        "member_ids"
      ],
      "properties": {
        "group_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "op": {
          "enum": [
            "CREATED",
            "INVITED",
            "ACCEPTED",
            "DECLINED",
            "LEFT"
          ]
        },
        "actor_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "subject_id": {
          "$ref": "common.schema.json#/$defs/nullable_id"
        },
        "member_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    "action_resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "result"
      ],
      "properties": {
        "request": {
          "description": "The request as received; may be invalid (then result.reason_code is INVALID_SCHEMA).",
          "type": "object"
        },
        "result": {
          "$ref": "action_result.schema.json"
        }
      }
    },
    "link_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "CONNECTED",
            "DISCONNECTED",
            "REFUSED"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "scenario_event": {
      "description": "One entry of the scenario's event tape, played by the host through the action gate (G3a).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "event_type",
        "actor_id",
        "reason_code"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,47}$"
        },
        "actor_id": {
          "$ref": "common.schema.json#/$defs/nullable_id"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z_]{1,40}$"
        },
        "resulting_event_ids": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    "expression_shown": {
      "description": "A body showed an expression from the catalog (EXPRESS). Who perceived it is in the matching comms_event.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avatar_id",
        "event_id",
        "expression_id",
        "expression",
        "hold_ms"
      ],
      "properties": {
        "avatar_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "event_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "expression_id": {
          "$ref": "common.schema.json#/$defs/expression_id"
        },
        "expression": {
          "$ref": "common.schema.json#/$defs/expression"
        },
        "hold_ms": {
          "$ref": "common.schema.json#/$defs/time_ms"
        }
      }
    },
    "final_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avatar_id",
        "x",
        "y",
        "z",
        "yaw_rad",
        "links_used"
      ],
      "properties": {
        "avatar_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "yaw_rad": {
          "type": "number"
        },
        "links_used": {
          "description": "Navigation links entered during the run, in order (evaluator).",
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    "intervention_journal": {
      "description": "A Director intervention (G4b, D-97): applied or refused, with the request and the intervention record. Watching is never journaled (D-92); changing the world is.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "request",
        "intervention"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPLIED",
            "REFUSED"
          ]
        },
        "reason": {
          "oneOf": [
            {
              "enum": [
                "PERMISSION_DENIED",
                "NOT_BUILT",
                "UNKNOWN_OPERATION",
                "TYPE_MISMATCH",
                "UNKNOWN_TARGET",
                "NOT_EDITABLE",
                "INVALID_VALUE",
                "OFF_MAP",
                "INSIDE_WALL",
                "ON_AVATAR",
                "BLOCKS_ROUTE",
                "UNKNOWN_PROP",
                "NOT_FOUND",
                "EVENT_REFUSED",
                "NO_AGENT_LINK"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "$ref": "envelope.schema.json#/$defs/director_request"
        },
        "intervention": {
          "oneOf": [
            {
              "$ref": "intervention.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "APPLIED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "intervention": {
                "$ref": "intervention.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REFUSED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "PERMISSION_DENIED",
                  "NOT_BUILT",
                  "UNKNOWN_OPERATION",
                  "TYPE_MISMATCH",
                  "UNKNOWN_TARGET",
                  "NOT_EDITABLE",
                  "INVALID_VALUE",
                  "OFF_MAP",
                  "INSIDE_WALL",
                  "ON_AVATAR",
                  "BLOCKS_ROUTE",
                  "UNKNOWN_PROP",
                  "NOT_FOUND",
                  "EVENT_REFUSED",
                  "NO_AGENT_LINK"
                ]
              },
              "intervention": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
