{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soma-range.invalid/v1/map.schema.json",
  "title": "Map config",
  "description": "configs/maps/*.yaml. Floor in meters, Godot convention (x right, z toward the viewer, y up; D-29). Each zone declares environment values that drive both rendering and simulated perception (ART_DIRECTION §5, D-26).",
  "x-audience": "config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "version", "name", "bounds", "zones", "walls", "spawn_points"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "map_id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "bounds": {
      "description": "Floor rectangle, from (0, 0) to (width_m, depth_m).",
      "type": "object",
      "additionalProperties": false,
      "required": ["width_m", "depth_m"],
      "properties": {
        "width_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 },
        "depth_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/zone" }
    },
    "walls": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/wall" }
    },
    "platforms": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/platform" }
    },
    "nav_links": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/nav_link" }
    },
    "props": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/prop" }
    },
    "spawn_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/spawn_point" }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_min", "z_min", "x_max", "z_max"],
      "properties": {
        "x_min": { "type": "number" },
        "z_min": { "type": "number" },
        "x_max": { "type": "number" },
        "z_max": { "type": "number" }
      }
    },
    "environment": {
      "description": "Simple, labeled-synthetic proxies, not models of real optics or acoustics.",
      "type": "object",
      "additionalProperties": false,
      "required": ["light_level", "visual_range_factor", "noise_floor_db"],
      "properties": {
        "light_level": { "$ref": "common.schema.json#/$defs/unit_interval" },
        "visual_range_factor": { "$ref": "common.schema.json#/$defs/unit_interval" },
        "noise_floor_db": { "type": "number", "minimum": 0, "maximum": 140 },
        "backlit": { "type": "boolean" },
        "light_preset": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
        "atmosphere_preset": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone_id", "area", "environment"],
      "properties": {
        "zone_id": { "$ref": "common.schema.json#/$defs/id" },
        "area": { "$ref": "#/$defs/rect" },
        "environment": { "$ref": "#/$defs/environment" }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_id", "a", "b", "height_m", "blocks_sight", "blocks_sound"],
      "properties": {
        "wall_id": { "$ref": "common.schema.json#/$defs/id" },
        "a": { "$ref": "common.schema.json#/$defs/point2" },
        "b": { "$ref": "common.schema.json#/$defs/point2" },
        "height_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "blocks_sight": { "type": "boolean" },
        "blocks_sound": { "type": "boolean" },
        "acoustically_reflective": { "type": "boolean" },
        "movable": { "type": "boolean" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_id", "area", "height_m"],
      "properties": {
        "platform_id": { "$ref": "common.schema.json#/$defs/id" },
        "area": { "$ref": "#/$defs/rect" },
        "height_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
      }
    },
    "nav_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "kind", "from", "to", "required_capability"],
      "properties": {
        "link_id": { "$ref": "common.schema.json#/$defs/id" },
        "kind": { "enum": ["STAIRS", "RAMP"] },
        "from": { "$ref": "common.schema.json#/$defs/point2" },
        "to": { "$ref": "common.schema.json#/$defs/point2" },
        "required_capability": {
          "description": "Body capability flag that must be true to use this link.",
          "enum": ["can_use_stairs", "can_use_ramp"]
        }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prop_id", "prop_type", "position"],
      "properties": {
        "prop_id": { "$ref": "common.schema.json#/$defs/id" },
        "prop_type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
        "position": { "$ref": "common.schema.json#/$defs/point2" },
        "yaw_rad": { "type": "number" }
      }
    },
    "spawn_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spawn_id", "position", "yaw_rad"],
      "properties": {
        "spawn_id": { "$ref": "common.schema.json#/$defs/id" },
        "position": { "$ref": "common.schema.json#/$defs/point2" },
        "yaw_rad": { "type": "number", "minimum": -6.283185307179586, "maximum": 6.283185307179586 }
      }
    }
  }
}
