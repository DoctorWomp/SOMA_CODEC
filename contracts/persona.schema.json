{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soma-range.invalid/v1/persona.schema.json",
  "title": "Persona config",
  "description": "configs/personas/*.yaml. Personas describe tendencies, not labels of worth (Blueprint §6.3). private_goal is for the persona's own agent and the evaluator only; it never reaches Robot R except through observable behavior (D-13).",
  "x-audience": "config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "persona_id", "display_name", "role", "public_goal", "private_goal",
    "knows", "does_not_know", "style", "default_body", "cognition_level", "allowed_actions"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "persona_id": { "$ref": "common.schema.json#/$defs/id" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
    "public_goal": { "$ref": "common.schema.json#/$defs/short_text" },
    "private_goal": {
      "description": "EVALUATOR / OWN AGENT ONLY.",
      "oneOf": [{ "$ref": "common.schema.json#/$defs/short_text" }, { "type": "null" }]
    },
    "knows": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "common.schema.json#/$defs/short_text" }
    },
    "does_not_know": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "common.schema.json#/$defs/short_text" }
    },
    "style": {
      "description": "Persona Mixer sliders, 0-100 (Blueprint §6.2).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sociability", "assertiveness", "politeness", "expressivity", "playfulness",
        "patience", "skepticism", "situational_attention", "adaptability"
      ],
      "properties": {
        "sociability": { "$ref": "#/$defs/slider" },
        "assertiveness": { "$ref": "#/$defs/slider" },
        "politeness": { "$ref": "#/$defs/slider" },
        "expressivity": { "$ref": "#/$defs/slider" },
        "playfulness": { "$ref": "#/$defs/slider" },
        "patience": { "$ref": "#/$defs/slider" },
        "skepticism": { "$ref": "#/$defs/slider" },
        "situational_attention": { "$ref": "#/$defs/slider" },
        "adaptability": { "$ref": "#/$defs/slider" }
      }
    },
    "default_body": { "$ref": "common.schema.json#/$defs/id" },
    "cognition_level": { "enum": ["C0", "C1", "C2"] },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/action_name" }
    }
  },
  "$defs": {
    "slider": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
