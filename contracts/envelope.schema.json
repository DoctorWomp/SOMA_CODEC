{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soma-range.invalid/v1/envelope.schema.json",
  "title": "Transport envelope",
  "description": "Wrapper for every message on the Godot ↔ Python WebSocket (D-05, Blueprint §12). The payload is validated against the schema its type names. The session token is checked at connection time and never appears in envelopes, so it never reaches a journal (D-29).",
  "x-audience": "transport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "type",
    "tick_id",
    "sim_time_ms",
    "source",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "message_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "type": {
      "enum": [
        "world.observation",
        "horizon.delta_feature",
        "horizon.hypothesis",
        "agent.action_request",
        "world.action_result",
        "comms.event",
        "director.intervention",
        "link.hello",
        "link.heartbeat",
        "link.step",
        "director.request",
        "director.result"
      ]
    },
    "tick_id": {
      "$ref": "common.schema.json#/$defs/tick"
    },
    "sim_time_ms": {
      "$ref": "common.schema.json#/$defs/time_ms"
    },
    "source": {
      "enum": [
        "godot_world",
        "range_service",
        "testworld",
        "operator_ui"
      ]
    },
    "payload": {
      "description": "Closed by the schema named in type.",
      "type": "object",
      "x-closed-by": "type"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "world.observation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "observation.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "horizon.delta_feature"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "delta_feature.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "horizon.hypothesis"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "hypothesis.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.action_request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "action_request.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "world.action_result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "action_result.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "comms.event"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "comms_event.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "director.intervention"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "intervention.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "link.hello"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/link_hello"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "link.heartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/link_heartbeat"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "link.step"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/link_step"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "director.request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/director_request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "director.result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/director_result"
          }
        }
      }
    }
  ],
  "$defs": {
    "link_hello": {
      "description": "Sent by Godot after connecting: which agents this session controls and the run's timing. The sidecar answers with a link.hello listing the agents it runs. The session token is never in an envelope (D-29).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "agents",
        "tick_hz",
        "sample_hz",
        "map_id"
      ],
      "properties": {
        "protocol": {
          "const": "range-link/1"
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "tick_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "sample_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "map_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "run_mode": {
          "description": "STEPPED: Godot holds the world after each sample until the sidecar sends link.step AGENTS_DONE for it. LIVE (default): the world never waits (D-44). See D-48.",
          "enum": [
            "LIVE",
            "STEPPED"
          ]
        }
      }
    },
    "link_heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "link_step": {
      "description": "Stepped runs (D-48): Godot sends SAMPLE_SENT after the observation packets of one sample; the sidecar sends AGENTS_DONE once every agent has answered that sample.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_tick_id",
        "phase"
      ],
      "properties": {
        "sample_tick_id": {
          "$ref": "common.schema.json#/$defs/tick"
        },
        "phase": {
          "enum": [
            "SAMPLE_SENT",
            "AGENTS_DONE"
          ]
        }
      }
    },
    "director_request": {
      "description": "G4b (D-97): an intervention the Director asked for, or an inspection (INSPECT_AGENT). Godot sends agent-side ones to the sidecar; recipes carry the same shape.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "operator",
        "intervention_type",
        "operation",
        "target_id",
        "args",
        "pre_scheduled"
      ],
      "properties": {
        "request_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "operator": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "intervention_type": {
          "oneOf": [
            {
              "enum": [
                "DIRECTIVE_EDIT",
                "WORLD_CHANGE",
                "EVENT_TRIGGER",
                "ENVIRONMENTAL_INFLUENCE",
                "SOCIAL_INFLUENCE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "enum": [
            "EDIT_DIRECTIVE",
            "PLACE_PROP",
            "MOVE_PROP",
            "REMOVE_PROP",
            "TRIGGER_EVENT",
            "PA_ANNOUNCEMENT",
            "NPC_SAY",
            "INSPECT_AGENT"
          ]
        },
        "target_id": {
          "$ref": "common.schema.json#/$defs/nullable_id"
        },
        "args": {
          "description": "Flat operation arguments, as in contracts/intervention: snake_case keys, scalar values. Which keys each operation takes is checked by range_service/director.py and director.gd (x-closed-by operation).",
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "x-closed-by": "operation"
        },
        "pre_scheduled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "description": "Only an inspection has no intervention type.",
          "if": {
            "properties": {
              "operation": {
                "const": "INSPECT_AGENT"
              }
            }
          },
          "then": {
            "properties": {
              "intervention_type": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "intervention_type": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "director_result": {
      "description": "G4b (D-97, D-98): the sidecar's answer to a director.request: the applied intervention with before/after, a refusal with its reason, or an inspection of the agent's editable parts (a Director/Evaluator view; never sent to any agent).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "status",
        "reason",
        "intervention",
        "editable"
      ],
      "properties": {
        "request_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "status": {
          "enum": [
            "APPLIED",
            "REFUSED",
            "INSPECTED"
          ]
        },
        "reason": {
          "oneOf": [
            {
              "enum": [
                "PERMISSION_DENIED",
                "NOT_BUILT",
                "UNKNOWN_OPERATION",
                "TYPE_MISMATCH",
                "UNKNOWN_TARGET",
                "NOT_EDITABLE",
                "INVALID_VALUE",
                "OFF_MAP",
                "INSIDE_WALL",
                "ON_AVATAR",
                "BLOCKS_ROUTE",
                "UNKNOWN_PROP",
                "NOT_FOUND",
                "EVENT_REFUSED",
                "NO_AGENT_LINK"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention": {
          "oneOf": [
            {
              "$ref": "intervention.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "editable": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "directive",
                "goal",
                "sliders",
                "locked"
              ],
              "properties": {
                "directive": {
                  "type": "string",
                  "maxLength": 4000
                },
                "goal": {
                  "type": "string",
                  "maxLength": 1000
                },
                "sliders": {
                  "type": "object",
                  "maxProperties": 16,
                  "propertyNames": {
                    "pattern": "^[a-z][a-z_]{1,31}$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "x-closed-by": "persona style names (checked against the agent's persona)"
                },
                "locked": {
                  "description": "What the Director can see but never edit (Blueprint §10.2).",
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "APPLIED"
              }
            }
          },
          "then": {
            "properties": {
              "intervention": {
                "$ref": "intervention.schema.json"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REFUSED"
              }
            }
          },
          "then": {
            "properties": {
              "intervention": {
                "type": "null"
              },
              "reason": {
                "enum": [
                  "PERMISSION_DENIED",
                  "NOT_BUILT",
                  "UNKNOWN_OPERATION",
                  "TYPE_MISMATCH",
                  "UNKNOWN_TARGET",
                  "NOT_EDITABLE",
                  "INVALID_VALUE",
                  "OFF_MAP",
                  "INSIDE_WALL",
                  "ON_AVATAR",
                  "BLOCKS_ROUTE",
                  "UNKNOWN_PROP",
                  "NOT_FOUND",
                  "EVENT_REFUSED",
                  "NO_AGENT_LINK"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INSPECTED"
              }
            }
          },
          "then": {
            "properties": {
              "editable": {
                "not": {
                  "type": "null"
                }
              },
              "intervention": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
