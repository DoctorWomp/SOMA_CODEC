{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-range.invalid/contracts/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "trace_id",
    "tick",
    "recipient_id",
    "source_id",
    "channel",
    "visibility",
    "content"
  ],
  "properties": {
    "protocol": {
      "const": "soma-range/1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "recipient_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel": {
      "enum": [
        "speech",
        "gesture",
        "environment"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "content": {
      "type": "string",
      "maxLength": 4096
    }
  }
}
