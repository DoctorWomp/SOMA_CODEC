{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soma-range.invalid/v1/body.schema.json",
  "title": "Body config",
  "description": "configs/bodies/*.yaml, contract version 2.0 (D-37). A body is the physical part of an avatar: size, collider, movement limits, hard capability flags, senses, and the gestures and expression channels it can use (Blueprint §6.2, D-36). The world enforces these; no persona slider can bypass a missing capability. A role such as Robot R is not a body: a scenario chooses which body plays it.",
  "x-audience": "config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "body_id",
    "kind",
    "dimensions",
    "motion",
    "reach_m",
    "arms",
    "capabilities",
    "sensors",
    "gestures",
    "expression_channels"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/body_schema_version"
    },
    "body_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "kind": {
      "enum": [
        "HUMAN_WALKER",
        "LEGGED_HUMANOID",
        "WHEELED_HUMANOID",
        "QUADRUPED",
        "SCRIPTED_CROWD"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height_m",
        "collider"
      ],
      "properties": {
        "height_m": {
          "description": "Overall height when standing or stowed.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "collider": {
          "description": "Physics shape the world uses, around the vertical axis. length_m runs along the body's facing direction, width_m across it. CAPSULE and CYLINDER are round: length_m must equal width_m (the diameter). Navigation keeps the body's center at least the turning radius from obstacles: half the width for round shapes, half the diagonal for BOX (D-37).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "length_m",
            "width_m"
          ],
          "properties": {
            "shape": {
              "enum": [
                "CAPSULE",
                "CYLINDER",
                "BOX"
              ]
            },
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            },
            "width_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_speed_m_s",
        "max_accel_m_s2",
        "max_turn_rate_rad_s"
      ],
      "properties": {
        "max_speed_m_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "max_accel_m_s2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "max_turn_rate_rad_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        }
      }
    },
    "reach_m": {
      "description": "How far the body can reach to touch or hand over. 0 for a body with no arm.",
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "arms": {
      "description": "Number of arms. Gestures that need an arm (waving, pointing, handing over) require at least one.",
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_walk",
        "can_use_stairs",
        "can_use_ramp",
        "can_use_elevator",
        "can_speak",
        "can_gesture",
        "can_grab",
        "can_sit",
        "can_access_staff_areas",
        "can_use_pa"
      ],
      "properties": {
        "can_walk": {
          "description": "Moves across the floor (legs or wheels).",
          "type": "boolean"
        },
        "can_use_stairs": {
          "type": "boolean"
        },
        "can_use_ramp": {
          "type": "boolean"
        },
        "can_use_elevator": {
          "type": "boolean"
        },
        "can_speak": {
          "type": "boolean"
        },
        "can_gesture": {
          "type": "boolean"
        },
        "can_grab": {
          "type": "boolean"
        },
        "can_sit": {
          "description": "Can take a sitting posture (SIT_IN_PLACE) or sit on a chair.",
          "type": "boolean"
        },
        "can_access_staff_areas": {
          "type": "boolean"
        },
        "can_use_pa": {
          "type": "boolean"
        }
      }
    },
    "sensors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount_height_m",
        "fov_deg",
        "visual_range_m",
        "acoustic_range_m",
        "cadence_hz",
        "dropout_rate"
      ],
      "properties": {
        "mount_height_m": {
          "description": "Height of the eyes or main sensor head above the floor. The observer filter (G2) casts sight lines from here, so low sensors are blocked by partitions and crowds that taller bodies see over. Must not exceed height_m.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "fov_deg": {
          "description": "Horizontal field of view of the main sensors, centered on the facing direction.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 360
        },
        "visual_range_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "acoustic_range_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "cadence_hz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "dropout_rate": {
          "$ref": "common.schema.json#/$defs/unit_interval"
        }
      }
    },
    "gestures": {
      "description": "Gestures this body can perform. Empty when can_gesture is false.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/gesture"
      }
    },
    "expression_channels": {
      "description": "How this body can express itself. SPEECH requires can_speak.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/expression_channel"
      }
    },
    "rig": {
      "description": "Optional skeleton settings (D-54, D-56; docs/gates/RIG_PLAN.md). Pose is presentation only: nothing here changes the collider, movement, senses or journal. Without this block a robot body gets its family's defaults (the skeleton follows from kind and arms). Joint names and axes per family are listed in RIG_PLAN.md and checked by tools/validate_configs.py.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skeleton"
      ],
      "properties": {
        "skeleton": {
          "description": "Skeleton family. HUMANOID: legged and wheeled humanoids (the wheeled one has a torso mount and wheels instead of legs). QUADRUPED: a rigid body with no neck and four 3-joint legs; the legs pose the whole body (yaw, pitch, roll) over planted feet.",
          "enum": [
            "HUMANOID",
            "QUADRUPED"
          ]
        },
        "arm_module": {
          "description": "Adds the 7-bone arm module (dorsal mount). Needs arms >= 1. Default: true for a quadruped with an arm.",
          "type": "boolean"
        },
        "joint_limits_deg": {
          "description": "Overrides of the family's joint limits, per joint and axis, e.g. {Neck: {yaw: [-60, 60]}}. Head yaw is never beyond +/-85 degrees.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Za-z]{1,23}$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "yaw",
                "pitch",
                "roll",
                "flex",
                "curl",
                "abduct",
                "open"
              ]
            },
            "additionalProperties": {
              "description": "[min, max] in degrees.",
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              }
            }
          }
        },
        "head_turn_speed_deg_s": {
          "description": "How fast the head (a quadruped: its whole body) turns toward a gaze target.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 720
        },
        "gesture_amplitude": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "common.schema.json#/$defs/prosody_factor"
            },
            "max": {
              "$ref": "common.schema.json#/$defs/prosody_factor"
            }
          },
          "description": "The range this body clamps a gesture's amplitude to. Must include 1."
        },
        "gesture_tempo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "common.schema.json#/$defs/prosody_factor"
            },
            "max": {
              "$ref": "common.schema.json#/$defs/prosody_factor"
            }
          },
          "description": "The range this body clamps a gesture's tempo to. Must include 1."
        },
        "gait": {
          "description": "Gait parameters for legged bodies, used from rig step B (foot IK).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step_height_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            },
            "step_length_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.5
            },
            "cadence_hz": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            }
          }
        }
      }
    }
  }
}
